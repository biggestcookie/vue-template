{
  "name": "vue-ts-template",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "lint": "npm run lint:format && npm run lint:fix",
    "lint:format": "prettier --log-level warn --write src/**/*.{js,ts,vue,css,scss,md,json}",
    "lint:fix": "eslint ./src --ext .js,.ts,.vue --quiet --fix"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "bulma": "^1.0.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vue": "^3.5.32",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.7"
  },
  "prettier": {
    "singleQuote": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "trailingComma": "es5"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
